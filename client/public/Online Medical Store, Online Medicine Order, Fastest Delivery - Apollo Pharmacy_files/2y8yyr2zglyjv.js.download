      patientId: $patientId
      pageSize: $pageSize
      refStartDate: $refStartDate
      status: $status
    ) {
      medicineOrdersList {
        id
        createdDate
        orderAutoId
        billNumber
        billedItems {
          billedDiscountPrice
          billedMrp
          billedPrice
          billedQty
          itemId
          itemName
          orderedDiscountPrice
          orderedMrp
          orderedPrice
          orderedQty
          thumbnail
          typeId
        }
        shopAddress
        deliveryType
        currentStatus
        orderDateTime
        orderTat
        oldOrderTat
        latestOrderStatus
        medicineOrdersStatus {
          id
          statusDate
          orderStatus
          hideStatus
        }
        medicineOrderLineItems {
          medicineSKU
          medicineName
          price
          mrp
          quantity
          isMedicine
          mou
          isPrescriptionNeeded
          thumbnail
          typeId
        }
        medicineOrderShipments {
          medicineOrderInvoice {
            itemDetails
          }
        }
        quoteDateTime
        transactionId
        prescriptionImageUrl
        prismPrescriptionFileId
        appointmentId
        consultInfo {
          doctorName
          appointmentDateTime
        }
        medicineOrderAddress {
          name
        }
        meta {
          shipmentNo
          totalShipments
          reUploadPresc
        }
        paymentOrderId
      }
    }
  }
