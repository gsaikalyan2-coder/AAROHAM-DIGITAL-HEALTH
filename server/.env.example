# Phase 2

DATABASE_URL=postgresql://postgres:root@localhost:5432/health_management
PORT=5432
# Phase 5A — PostgreSQL connection string. REQUIRED by db:migrate and db:seed.
# PostgreSQL 14 or later is the only supported engine.
#
#   local     postgresql://postgres:postgres@localhost:5432/Aaroham
#   Supabase  Dashboard -> Connect -> Session pooler
#             postgresql://postgres.<ref>:<pw>@aws-<region>.pooler.supabase.com:5432/postgres
#
# SUPABASE: use the SESSION pooler (port 5432), not the transaction pooler
# (port 6543). Transaction mode has no prepared statements and no session-scoped
# advisory locks, both of which the migration runner needs. db.js refuses a
# 6543 URL rather than failing confusingly halfway through a migration.
# The direct connection (db.<ref>.supabase.co:5432) also works, but is
# IPv6-only on the free plan and most home networks in India are IPv4-only.
#
# TLS is enabled automatically for any non-localhost host — a dashboard
# connection string omits sslmode, and that omission must not silently send
# health records unencrypted.
#
# URL-ENCODE special characters in the password: @ -> %40, # -> %23, / -> %2F
DATABASE_URL=

# Phase 6 — generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Phase 7 — MSG91 / Twilio
OTP_PROVIDER_KEY=

# Phase 12
UPLOAD_DIR=./uploads
